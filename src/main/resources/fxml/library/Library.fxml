<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../../css/style.css" styleClass="root-pane">
    <HBox spacing="10" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
        <!-- Label -->
        <Label fx:id="libraryLabel" text="Library" styleClass="library-label"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <!-- Button -->
        <Button fx:id="refreshButton" text="Refresh" styleClass="refresh-button"/>
    </HBox>

    <!-- Filter TextField -->
    <TextField fx:id="filterField" styleClass="search-field" promptText="Search for a Track (name, artist or album)..."
               AnchorPane.topAnchor="50.0"
               AnchorPane.leftAnchor="20.0"
               AnchorPane.rightAnchor="20.0"/>

    <!-- ListView -->
    <ListView fx:id="libraryListView" styleClass="library-list-view"
              AnchorPane.topAnchor="80.0"
              AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"/>
</AnchorPane>