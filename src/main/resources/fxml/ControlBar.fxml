<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/style.css">
    <HBox spacing="20" styleClass="control-bar" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Left: Song Title and Artist -->
        <VBox alignment="CENTER_LEFT" spacing="5" prefWidth="200" maxWidth="200">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fx:id="albumCoverView" fitHeight="50" fitWidth="50" preserveRatio="true"
                           styleClass="album-cover"/>
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label fx:id="songTitleLabel" styleClass="song-title-label" text="Music Title" maxWidth="200"
                           ellipsisString="...">
                        <HBox.hgrow>
                            NEVER
                        </HBox.hgrow>
                    </Label>
                    <Label fx:id="artistLabel" styleClass="artist-label" text="Artist" maxWidth="200"
                           ellipsisString="...">
                        <HBox.hgrow>
                            NEVER
                        </HBox.hgrow>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
        <!--Lyrics button -->
        <Button fx:id="lyricsButton" text="" styleClass="icon-button">
            <graphic>
                <ImageView fx:id="lyricsIcon" fitHeight="16" preserveRatio="true">
                    <Image url="/icons/lyrics.png"/>
                </ImageView>
            </graphic>
        </Button>


        <!-- Center: Progress Bar and Time -->
        <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS">
            <!-- Music control buttons section, above the progress bar -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="slowDownButton" text="⏪ Slow Down" styleClass="button-slow"/>
                <Button fx:id="previousButton" text="⏮" styleClass="previous-button"/>
                <Button fx:id="pauseButton" text="▶" styleClass="pause-button"/>
                <Button fx:id="shuffleButton" text="" styleClass="button-shuffle">
                    <graphic>
                        <ImageView fx:id="shuffleIcon" fitHeight="16" preserveRatio="true">
                            <Image url="/icons/shuffle.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="nextButton" text="⏭" styleClass="next-button"/>
                <Button fx:id="speedUpButton" text="Speed Up ⏩" styleClass="button-speed"/>
            </HBox>
            <Slider fx:id="progressSlider" max="100" min="0" styleClass="progress-slider" value="0"/>
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="currentTimeLabel" styleClass="time-label" text="00:00"/>
                <Label styleClass="time-label" text="/"/>
                <Label fx:id="totalTimeLabel" styleClass="time-label" text="00:00"/>
            </HBox>
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="5" HBox.hgrow="NEVER">
            <!-- Volume and balance section -->
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="toggleVolumeButton" styleClass="icon-button">
                    <graphic>
                        <ImageView fitHeight="16" preserveRatio="true">
                            <Image url="/icons/volume.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="toggleBalanceButton" styleClass="icon-button">
                    <graphic>
                        <ImageView fitHeight="16" preserveRatio="true">
                            <Image url="/icons/balance.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
            <StackPane>
                <Slider fx:id="volumeSlider" min="0" max="1" value="0.5" styleClass="volume-slider" visible="true"/>
                <Slider fx:id="balanceSlider" min="-1.0" max="1.0" value="0.0" blockIncrement="0.1"
                        styleClass="balance-slider" visible="false"/>
            </StackPane>
        </VBox>
        <VBox>
            <Label fx:id="transitionLabel" styleClass="transition-label" text="Transition: 2.5s"/>
            <Slider fx:id="transitionSlider" max="5" value="2.5" styleClass="transition-slider"/>
        </VBox>
    </HBox>
</AnchorPane>
