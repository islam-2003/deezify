<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/style.css"
      spacing="0" alignment="CENTER" styleClass="lyrics-container">
    <TextArea fx:id="lyricsTextArea" editable="false" wrapText="true" styleClass="lyrics-text" VBox.vgrow="ALWAYS"/>
    <Button fx:id="closeButton" text="Close" styleClass="icon-button"/>
</VBox>