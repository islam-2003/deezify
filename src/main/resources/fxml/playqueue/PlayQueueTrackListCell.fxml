<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<HBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER_LEFT">
    <Label fx:id="trackLabel" styleClass="track-label"/>
    <Pane HBox.hgrow="ALWAYS"/>
    <Button fx:id="button" styleClass="add-button">
        <graphic>
            <ImageView fitHeight="16" preserveRatio="true">
                <Image url="/icons/trash.png"/>
            </ImageView>
        </graphic>
    </Button>
</HBox>
