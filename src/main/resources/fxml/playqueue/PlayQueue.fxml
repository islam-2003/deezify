<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../../css/style.css" styleClass="root-pane">
    <!-- Label -->
    <Label fx:id="playQueueLabel" text="Play Queue" styleClass="play-queue-label"
           AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="20.0"/>

    <!-- Button -->
    <Button fx:id="clearButton" text="Clear Queue" styleClass="play-queue-button"
            AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="20.0"/>

    <!-- ListView -->
    <ListView fx:id="playQueueListView" styleClass="play-queue-list-view"
              AnchorPane.topAnchor="50.0"
              AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"/>
</AnchorPane>